          1.055,
          1.005,
          0.945
        ],
        "target_mean_red_minus_blue_0_255": 30.0
      },
      {
        "order": 4,
        "op": "filmic_curve",
        "points": [
          [
            0.0,
            0.0
          ],
          [
            0.05,
            0.022
          ],
          [
            0.18,
            0.13
          ],
          [
            0.5,
            0.49
          ],
          [
            0.82,
            0.87
          ],
          [
            1.0,
            0.985
          ]
        ],
        "interpolation": "monotonic_linear_lut_4096"
      },
      {
        "order": 5,
        "op": "split_tone",
        "shadow_rgb": [
          0.985,
          1.005,
          1.018
        ],
        "highlight_rgb": [
          1.03,
          1.01,
          0.97
        ],
        "shadow_end": 0.35,
        "highlight_start": 0.62
      },
      {
        "order": 6,
        "op": "selective_saturation",
        "global": 1.06,
        "orange_red": 1.1,
        "green": 0.9,
        "cyan_blue": 0.94,
        "skin_protect": true
      },
      {
        "order": 7,
        "op": "local_contrast",
        "unsharp_radius_px_at_720": 1.1,
        "amount": 0.12
      },
      {
        "order": 8,
        "op": "vignette",
        "strength": 0.16,
        "inner_radius": 0.48,
        "outer_radius": 0.95,
        "center": [
          0.5,
          0.48
        ]
      },
      {
        "order": 9,
        "op": "deterministic_luma_grain",
        "sigma": 0.006,
        "seed_formula": "scene_index*100000 + frame_index",
        "chroma_grain": false
      }
    ],
    "text_readability": {
      "method": "soft full-frame/radial darkening only",
      "hard_rectangles_forbidden": true,
      "gray_boxes_forbidden": true,
      "max_extra_darkening": 0.22,
      "feather_px_at_720": 96
    }
