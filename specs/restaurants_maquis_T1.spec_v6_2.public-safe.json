      "guide_tournage": {
        "titre": "Le plat",
        "duree_a_tourner_s": 6.0,
        "prise": 1,
        "consigne": "Approche ton téléphone tout près du plat bien chaud pour montrer tous les détails. Commence un peu loin puis rapproche-toi doucement.",
        "mention_voix": "Tu peux parler pendant que tu filmes, en fon, yoruba, français ou anglais, pour présenter ton produit.",
        "exemples": {
          "fr": "Voici notre riz au poulet braisé bien chaud avec alloco, prêt maintenant !",
          "en": "This is our braised chicken rice with fried plantain, hot and ready right now!"
        },
        "langues_autorisees_de_parole": [
          "fon",
          "yoruba",
          "français",
          "anglais"
        ],
        "a_montrer": [
          "l'assiette entière",
          "la fumée ou le brillant de la sauce",
          "ta main qui sert"
        ],
        "a_eviter": [
          "filmer de trop loin",
          "montrer le sol ou le plafond",
          "bouger trop vite"
        ],
        "arret_automatique": "CameraX.setDurationLimit(6.0 s) — aucune action du commerçant",
        "carte_ecran_08": {
          "ligne_1": "SCÈNE 1/4",
          "ligne_2": "6 secondes",
          "exemple_affiche_sous_la_mention": "Voici notre riz au poulet braisé bien chaud avec alloco, prêt maintenant !"
        }
      }
    },
