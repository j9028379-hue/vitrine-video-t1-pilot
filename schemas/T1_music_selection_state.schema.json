{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrine.video/schemas/T1_music_selection_state.schema.json",
  "title": "T1 persisted music rotation state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "last_successful_music_id",
    "last_successful_render_job_id",
    "successful_render_count",
    "successful_render_jobs"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "last_successful_music_id": {
      "enum": [
        null,
        "t1_music_239426",
        "t1_music_464383",
        "t1_music_406552",
        "t1_music_178406"
      ]
    },
    "last_successful_render_job_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "successful_render_count": {
      "type": "integer",
      "minimum": 0
    },
    "successful_render_jobs": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "enum": [
          "t1_music_239426",
          "t1_music_464383",
          "t1_music_406552",
          "t1_music_178406"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"last_successful_music_id": {"type": "null"}}},
      "then": {
        "properties": {
          "last_successful_render_job_id": {"type": "null"},
          "successful_render_count": {"const": 0},
          "successful_render_jobs": {"maxProperties": 0}
        }
      },
      "else": {
        "properties": {
          "last_successful_render_job_id": {"type": "string", "minLength": 1},
          "successful_render_count": {"type": "integer", "minimum": 1},
          "successful_render_jobs": {"minProperties": 1}
        }
      }
    }
  ]
}
