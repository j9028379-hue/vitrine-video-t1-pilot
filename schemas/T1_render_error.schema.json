{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitrine.video/schemas/T1_render_error.schema.json",
  "title": "T1 Special Menu — RenderError",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "job_id",
    "template_id",
    "code",
    "message",
    "retryable",
    "stage",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "FAILED"
    },
    "job_id": {
      "type": "string"
    },
    "template_id": {
      "const": "restaurants_maquis_T1_special_menu_v1_0_0"
    },
    "code": {
      "enum": [
        "T1_INVALID_TEMPLATE_PACKAGE",
        "T1_INVALID_MERCHANT_PAYLOAD",
        "T1_MISSING_CAPTURE",
        "T1_UNSUPPORTED_MEDIA",
        "T1_CAPTURE_DURATION_OUT_OF_RANGE",
        "T1_CAPTURE_AUDIO_MISSING",
        "T1_CAPTURE_CORRUPT",
        "T1_INSUFFICIENT_STORAGE",
        "T1_UNSUPPORTED_DEVICE",
        "T1_ASSET_CHECKSUM_MISMATCH",
        "T1_FONT_LOAD_FAILED",
        "T1_RENDER_CANCELLED",
        "T1_RENDER_FAILED",
        "T1_OUTPUT_VALIDATION_FAILED"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "stage": {
      "enum": [
        "VALIDATING",
        "ANALYZING",
        "RENDERING",
        "ENCODING",
        "FINALIZING"
      ]
    },
    "scene_id": {
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4"
      ]
    },
    "details": {
      "type": "object"
    }
  }
}
